{
    "name": "rostering/server-vanilla",
    "description": "Vanilla PHP rostering service (strangler-fig migration target).",
    "type": "project",
    "require": {
        "php": ">=8.4",
        "firebase/php-jwt": "^7.1",
        "nesbot/carbon": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "require-dev": {
        "phpunit/phpunit": "^11"
    }
}

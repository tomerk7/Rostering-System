<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
            These are declared as <server> (with force="true"), not <env>, on purpose.
            The Docker container injects DB_CONNECTION, QUEUE_CONNECTION, CACHE_STORE,
            etc. into the process via env_file, which lands in $_SERVER. Laravel's
            env() reads $_SERVER/$_ENV (not getenv), so a <env> entry — which only
            updates $_ENV/putenv — does NOT override the container value, and the
            suite would otherwise run against the real dev database and the database
            queue. Forcing them onto $_SERVER keeps tests isolated.

            The schema relies on Postgres-only DDL (ALTER TABLE ... ADD CONSTRAINT
            ... CHECK), so tests run against a dedicated Postgres database
            (rostering_testing) rather than sqlite, while the array cache and sync
            queue keep them fast and synchronous.
        -->
        <server name="APP_ENV" value="testing" force="true"/>
        <server name="FRONTEND_URL" value="http://localhost:5173" force="true"/>
        <server name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <server name="BCRYPT_ROUNDS" value="4" force="true"/>
        <server name="BROADCAST_CONNECTION" value="null" force="true"/>
        <server name="CACHE_STORE" value="array" force="true"/>
        <server name="DB_CONNECTION" value="pgsql" force="true"/>
        <server name="DB_DATABASE" value="rostering_testing" force="true"/>
        <server name="DB_URL" value="" force="true"/>
        <server name="MAIL_MAILER" value="array" force="true"/>
        <server name="QUEUE_CONNECTION" value="sync" force="true"/>
        <server name="SESSION_DRIVER" value="array" force="true"/>
        <server name="PULSE_ENABLED" value="false" force="true"/>
        <server name="TELESCOPE_ENABLED" value="false" force="true"/>
        <server name="NIGHTWATCH_ENABLED" value="false" force="true"/>
    </php>
</phpunit>
